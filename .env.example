# Salin ke .env.local dan isi nilainya. JANGAN commit file .env.local.
# URL project Supabase, contoh: https://xxxx.supabase.co
SUPABASE_URL=your-supabase-project-url
# Service role key (Supabase -> Project Settings -> API). Hanya dipakai di server. Jangan beri prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# String acak minimal 32 karakter, contoh pembuatan: openssl rand -base64 48
JWT_SECRET=your-long-random-secret
